# Copy to `.env` and adjust port. Restart Metro (`npx expo start`) after changes.
#
# Android emulator → host machine’s localhost:
# EXPO_PUBLIC_BACKEND_API_BASE=http://10.0.2.2:3000
#
# iOS simulator:
# EXPO_PUBLIC_BACKEND_API_BASE=http://127.0.0.1:3000
#
# If your server already serves under /api/v1:
# EXPO_PUBLIC_BACKEND_API_BASE=http://10.0.2.2:3000/api/v1

EXPO_PUBLIC_BACKEND_API_BASE=http://10.0.2.2:3000
