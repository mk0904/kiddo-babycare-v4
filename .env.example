# Copy to `.env` as `.env` and restart Metro (`npx expo start`) after changes.
#
# App config (and other kiddo-service calls) use: GET {base}/api/v1/app/config
# unless EXPO_PUBLIC_BACKEND_API_BASE already ends with /api/v1.
#
# Local server on host port 8080 (e.g. "Listening and serving HTTP on :8080"):
#   Android emulator → use 10.0.2.2 (not localhost):
# EXPO_PUBLIC_BACKEND_API_BASE=http://10.0.2.2:8080
#   iOS simulator:
# EXPO_PUBLIC_BACKEND_API_BASE=http://127.0.0.1:8080
#   Physical device → your Mac’s LAN IP, same port:
# EXPO_PUBLIC_BACKEND_API_BASE=http://192.168.1.x:8080
#
# If the process already mounts routes at /api/v1:
# EXPO_PUBLIC_BACKEND_API_BASE=http://10.0.2.2:8080/api/v1

EXPO_PUBLIC_BACKEND_API_BASE=http://10.0.2.2:8080

# Ledger service URL is used by kiddo-service (server-side) for campaign credits after OTP.
# The app only sends optional lat/lng on verify-and-login — it does not call ledger directly.

# AppsFlyer (Step 2+ attribution) — from AppsFlyer dashboard → App settings
# EXPO_PUBLIC_APPSFLYER_DEV_KEY=your_dev_key
# EXPO_PUBLIC_APPSFLYER_IOS_APP_ID=1234567890
# EXPO_PUBLIC_APPSFLYER_ONELINK_ID=pjjk
