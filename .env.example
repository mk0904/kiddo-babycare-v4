# Copy this file to `.env` and fill in the values. Never commit `.env` to git.
#
# ─── Backend ───────────────────────────────────────────────────────────────────
# Local dev examples:
#   Android emulator  → use 10.0.2.2 (maps to host localhost)
#   iOS simulator     → use 127.0.0.1
#   Physical device   → your Mac's LAN IP, same port as the server
EXPO_PUBLIC_BACKEND_API_BASE=http://10.0.2.2:8080

# ─── Google Maps ───────────────────────────────────────────────────────────────
# From: Google Cloud Console → APIs & Services → Credentials
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─── Mixpanel ──────────────────────────────────────────────────────────────────
# From: https://mixpanel.com/project/settings
EXPO_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_project_token

# ─── CleverTap ─────────────────────────────────────────────────────────────────
# From: CleverTap Dashboard → Settings → Integration
EXPO_PUBLIC_CLEVERTAP_ACCOUNT_ID=your_clevertap_account_id
EXPO_PUBLIC_CLEVERTAP_ACCOUNT_TOKEN=your_clevertap_account_token
EXPO_PUBLIC_CLEVERTAP_FCM_SENDER_ID=your_fcm_sender_id

# ─── Nector (Loyalty & Rewards) ────────────────────────────────────────────────
# From: Nector Dashboard → API Settings
EXPO_PUBLIC_NECTOR_API_KEY=your_nector_read_only_api_key
EXPO_PUBLIC_NECTOR_WORKSPACE_ID=your_nector_workspace_id
EXPO_PUBLIC_NECTOR_LEAD_ID=your_nector_lead_id
EXPO_PUBLIC_NECTOR_RAZORPAY_SECRET_ID=your_nector_razorpay_secret_id

# ─── Searchanise ───────────────────────────────────────────────────────────────
EXPO_PUBLIC_SEARCHANISE_API_KEY=your_searchanise_api_key

# ─── Self-hosted Search Engine ─────────────────────────────────────────────────
EXPO_PUBLIC_SELF_SEARCH_API_KEY=your_self_search_api_key

# ─── AppsFlyer ─────────────────────────────────────────────────────────────────
# From: AppsFlyer Dashboard → App Settings
# EXPO_PUBLIC_APPSFLYER_DEV_KEY=your_dev_key
# EXPO_PUBLIC_APPSFLYER_IOS_APP_ID=1234567890
# EXPO_PUBLIC_APPSFLYER_ONELINK_ID=your_onelink_id

# ─── Internal Services ─────────────────────────────────────────────────────────
# Internal shared secret for Kiddo backend service authentication
EXPO_PUBLIC_KIDDO_SECRET=your_kiddo_service_secret

# ─── Shopify ───────────────────────────────────────────────────────────────────
# From: Shopify Admin → Apps → Develop apps → API credentials
EXPO_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
EXPO_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_api_access_token
EXPO_PUBLIC_SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your_admin_access_token
