{
  "expo": {
    "name": "Kiddo",
    "slug": "app",
    "version": "2.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "app",
      "kiddo"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.kiddo.ak",
      "associatedDomains": [
        "applinks:allforkiddo.com",
        "applinks:www.allforkiddo.com",
        "applinks:kiddo-app.onelink.me"
      ],
      "skAdNetworkIdentifiers": [
        "v9wttpbfk9.skadnetwork",
        "n38lu8286q.skadnetwork"
      ],
      "config": {
        "googleMapsApiKey": "PLACEHOLDER_GOOGLE_MAPS_KEY"
      },
      "infoPlist": {
        "NSAdvertisingAttributionReportEndpoint": "https://appsflyer-skadnetwork.com/",
        "NSLocationWhenInUseUsageDescription": "We need your location to show your address on the map",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We need your location to show your address on the map",
        "NSPhotoLibraryUsageDescription": "We need access to your photo library to allow you to upload images for your profile and orders",
        "LSApplicationQueriesSchemes": [
          "upi",
          "gpay",
          "phonepe",
          "paytmmp",
          "paytm",
          "bhim",
          "tez",
          "whatsapp",
          "razorpay"
        ]
      }
    },
    "android": {
      "splash": {
        "image": "./assets/images/new-splash-screen.png",
        "backgroundColor": "#f4eee5",
        "resizeMode": "cover"
      },
      "adaptiveIcon": {
        "backgroundColor": "#FFF4E8",
        "foregroundImage": "./assets/images/gpt1.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/gpt1.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.barereactnativeapp072",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "allforkiddo.com",
              "pathPattern": ".*"
            },
            {
              "scheme": "https",
              "host": "www.allforkiddo.com",
              "pathPattern": ".*"
            },
            {
              "scheme": "https",
              "host": "kiddo-app.onelink.me",
              "pathPattern": ".*"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "com.google.android.gms.permission.AD_ID"
      ],
      "googleServicesFile": "./android/app/google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "PLACEHOLDER_GOOGLE_MAPS_KEY"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://allforkiddo.com"
        }
      ],
      "expo-notifications",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Lexend-Regular.ttf",
            "./assets/fonts/Lexend-Medium.ttf",
            "./assets/fonts/Lexend-SemiBold.ttf",
            "./assets/fonts/Lexend-Bold.ttf"
          ],
          "ios": {
            "fonts": [
              "./assets/fonts/Lexend-Regular.ttf",
              "./assets/fonts/Lexend-Medium.ttf",
              "./assets/fonts/Lexend-SemiBold.ttf",
              "./assets/fonts/Lexend-Bold.ttf"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/new-splash-screen.png",
          "backgroundColor": "#ffffff",
          "resizeMode": "cover"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Allow tracking to help us measure ads and show you relevant offers."
        }
      ],
      [
        "@clevertap/clevertap-expo-plugin",
        {
          "accountId": "69R-748-Z77Z",
          "accountToken": "b4a-2c6",
          "accountRegion": "eu1",
          "fcmSenderId": "1083846018645",
          "customIdentifiers": "Email,Phone",
          "android": {
            "features": {
              "enablePush": true,
              "enableInApp": true,
              "enableInbox": true
            },
            "defaultNotificationChannelId": "default_channel"
          },
          "ios": {
            "mode": "production",
            "notifications": {
              "enablePushInForeground": true,
              "iosPushAppGroup": "group.com.kiddo.ak"
            }
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ]
    ],
    "splash": {
      "image": "./assets/images/new-splash-screen.png",
      "backgroundColor": "#ffffff",
      "resizeMode": "cover"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}