{
  "expo": {
    "name": "Kiddo",
    "slug": "app",
    "version": "1.9.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.kiddo.ak",
      "associatedDomains": ["applinks:app.kiddo.in"],
      "config": {
        "googleMapsApiKey": "PLACEHOLDER_GOOGLE_MAPS_KEY"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to show your address on the map",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We need your location to show your address on the map",
        "NSPhotoLibraryUsageDescription": "We need access to your photo library to allow you to upload images for your profile and orders",
        "LSApplicationQueriesSchemes": [
          "upi",
          "gpay",
          "phonepe",
          "paytmmp",
          "paytm",
          "bhim",
          "tez",
          "whatsapp",
          "razorpay"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF4E8",
        "foregroundImage": "./assets/images/gpt1.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/gpt1.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.barereactnativeapp072",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.kiddo.in",
              "pathPrefix": "/product"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./android/app/google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "PLACEHOLDER_GOOGLE_MAPS_KEY"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Lexend-Regular.ttf",
            "./assets/fonts/Lexend-Medium.ttf",
            "./assets/fonts/Lexend-SemiBold.ttf",
            "./assets/fonts/Lexend-Bold.ttf"
          ],
          "ios": {
            "fonts": [
              "./assets/fonts/Lexend-Regular.ttf",
              "./assets/fonts/Lexend-Medium.ttf",
              "./assets/fonts/Lexend-SemiBold.ttf",
              "./assets/fonts/Lexend-Bold.ttf"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "backgroundColor": "#ffffff",
          "resizeMode": "cover",
          "imageWidth": 200
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "1494379925573507",
          "clientToken": "04a657781e5dd2df8704fd3292d74e3d",
          "displayName": "kiddo-babycare",
          "advertiserIDCollectionEnabled": true,
          "autoLogAppEventsEnabled": false,
          "isAutoInitEnabled": false,
          "iosUserTrackingPermission": "Allow tracking to help us show you baby products, deals and recommendations that are most relevant to your little one's age and needs."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Allow tracking to help us show you baby products, deals and recommendations that are most relevant to your little one's age and needs."
        }
      ],
      [
        "@clevertap/clevertap-expo-plugin",
        {
          "accountId": "69R-748-Z77Z",
          "accountToken": "b4a-2c6",
          "accountRegion": "eu1",
          "customIdentifiers": "Email,Phone",
          "android": {
            "features": {
              "enablePush": true,
              "enableInApp": true,
              "enableInbox": true
            },
            "defaultNotificationChannelId": "default_channel"
          },
          "ios": {
            "mode": "production",
            "notifications": {
              "enablePushInForeground": true,
              "iosPushAppGroup": "group.com.kiddo.ak"
            }
          }
        }
      ]
    ],
    "splash": {
      "image": "./assets/images/icon.png",
      "backgroundColor": "#ffffff",
      "resizeMode": "cover"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
