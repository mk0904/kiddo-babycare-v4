	<array>
		<string>upi</string>
		<string>gpay</string>
		<string>phonepe</string>
		<string>paytmmp</string>
		<string>paytm</string>
		<string>bhim</string>
		<string>tez</string>
		<string>whatsapp</string>
		<string>razorpay</string>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>12.0</string>
