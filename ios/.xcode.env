# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# NODE_BINARY variable contains the PATH to the node executable.
#
# Customize the NODE_BINARY variable here.
# For example, to use nvm with brew, add the following line
# . "$(brew --prefix nvm)/nvm.sh" --no-use

# Try to find node
NODE_BINARY_CANDIDATE=$(command -v node 2>/dev/null)
if [ -n "$NODE_BINARY_CANDIDATE" ] && [ -f "$NODE_BINARY_CANDIDATE" ] && [ -x "$NODE_BINARY_CANDIDATE" ]; then
  export NODE_BINARY="$NODE_BINARY_CANDIDATE"
else
  # Fallback to hardcoded path
  if [ -f "/Users/farzan/.nvm/versions/node/v20.9.0/bin/node" ] && [ -x "/Users/farzan/.nvm/versions/node/v20.9.0/bin/node" ]; then
    export NODE_BINARY="/Users/farzan/.nvm/versions/node/v20.9.0/bin/node"
  elif [ -f "/usr/local/bin/node" ] && [ -x "/usr/local/bin/node" ]; then
    export NODE_BINARY="/usr/local/bin/node"
  elif [ -f "/opt/homebrew/bin/node" ] && [ -x "/opt/homebrew/bin/node" ]; then
    export NODE_BINARY="/opt/homebrew/bin/node"
  elif [ -f "/usr/bin/node" ] && [ -x "/usr/bin/node" ]; then
    export NODE_BINARY="/usr/bin/node"
  fi
fi

# Final check - ensure NODE_BINARY is set (will be overridden by .xcode.env.local if it exists)
if [ -z "$NODE_BINARY" ] || [ ! -f "$NODE_BINARY" ] || [ ! -x "$NODE_BINARY" ]; then
  echo "Warning: NODE_BINARY not found in .xcode.env. Check .xcode.env.local" >&2
fi
